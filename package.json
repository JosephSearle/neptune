{
  "name": "neptune",
  "version": "1.1.0",
  "private": true,
  "description": "Neptune: Joseph Searle's personal brand and design system.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "tokens.css",
    "tokens/",
    "components/bundle.css",
    "components/neptune.js",
    "brand/",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./bundle.css": "./components/bundle.css",
    "./neptune.js": "./components/neptune.js",
    "./tokens/*": "./tokens/*",
    "./brand/*": "./brand/*",
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "llms": "node scripts/build-llms.mjs",
    "lint": "stylelint \"components/**/*.css\"",
    "contrast": "node scripts/check-contrast.mjs",
    "check": "node scripts/build-tokens.mjs --check && node scripts/check-contrast.mjs && node scripts/build-llms.mjs --check && node --check components/neptune.js && npm run lint && node scripts/check-pack.mjs",
    "visual": "playwright test tests/visual.spec.js",
    "a11y": "playwright test tests/a11y.spec.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "stylelint": "^16.26.1"
  }
}
